<?xml version="1.0"?>
<ruleset name="Facilitador">
    <description>Padrão de código PSR-12 para o projeto Facilitador</description>

    <!-- Arquivos e diretórios a serem analisados -->
    <file>src/</file>

    <!-- Padrão base: PSR-12 -->
    <rule ref="PSR12"/>

    <!-- Configurações adicionais -->
    <arg name="colors"/>
    <arg value="sp"/>
    <arg name="parallel" value="8"/>

    <!-- Excluir vendor e outros diretórios -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/storage/*</exclude-pattern>
    <exclude-pattern>*/database/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>*/publishes/*</exclude-pattern>
</ruleset>
